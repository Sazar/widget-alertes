{
  "showProgressBar": {
    "type": "checkbox",
    "label": "Afficher la barre de progression",
    "value": true
  },

  "_section_general": { "type": "hidden", "value": "───── GÉNÉRAL ─────" },

  "alertDuration": {
    "type": "number",
    "label": "Durée d'alerte (secondes)",
    "value": 7,
    "min": 2,
    "max": 30,
    "step": 1
  },

  "alertDelay": {
    "type": "number",
