  "theme": {
    "type": "dropdown",
    "label": "Thème",
    "value": "twitch",
    "options": {
      "twitch":  "Twitch Purple",
      "neon":    "Neon Cyan",
      "fire":    "Fire Orange",
      "rose":    "Rose Pastel",
      "minimal": "Minimal Blanc",
      "gold":    "Gold",
      "ocean":   "Ocean",
      "custom":  "Personnalisé"
